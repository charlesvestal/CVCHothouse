{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "daisy-release",
      "displayName": "Daisy Seed (Release)",
      "description": "Build TapeScam firmware for Daisy Seed using the ARM GNU toolchain.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/daisy-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../extern/libDaisy/cmake/toolchains/ArmGNUToolchain.cmake"
      },
      "environment": {
        "CMAKE_C_COMPILER": "/usr/local/bin/arm-none-eabi-gcc",
        "CMAKE_CXX_COMPILER": "/usr/local/bin/arm-none-eabi-g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "daisy-release",
      "configurePreset": "daisy-release"
    }
  ]
}

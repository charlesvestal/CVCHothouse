#include "FIRConvolver.h"
#include "PsxTailReverb.h"
#include "IRAnalysis.h"
#include "PrecomputedIRProfiles.h"
#include "IRTaps1500.h"
#include "hothouse.h"
#include "daisysp.h"
#include <cstring>

using namespace daisy;
using namespace daisysp;
using clevelandmusicco::Hothouse;

/**
 * PSXVerb - Hybrid IR-Driven Reverb
 *
 * Architecture:
 * - Early reflections: True IR via time-domain FIR (40ms)
 * - Late reverb: Algorithmic tail fitted to IR measurements
 * - Zero-latency dry path
 *
 * All parameters extracted objectively from PS1 IRs.
 */

// Hardware
Hothouse hw;
Led led1;
Led led2;

// DSP engines
FIRConvolver fir;
PsxTailReverb tail;

// IR profiles (pre-analyzed)
IRProfile profiles[4];

// Define global tap storage in SDRAM
namespace PrecomputedProfiles {
    __attribute__((section(".sdram_bss"))) float g_AllTaps[4 * 1500];  // 24KB in SDRAM
}

// State
bool bypass_ = true;
bool reverb_ready_ = false;
int current_ir_index_ = 0;
float sample_rate_ = 48000.0f;

// Block size
constexpr size_t kBlockSize = 16;

// Parameter smoothing
struct ParamSmoother {
    float value = 0.0f;
    float coeff = 0.05f;

    void Init(float v) { value = v; }
    float Process(float target) {
        value += coeff * (target - value);
        return value;
    }
};

ParamSmoother smMix;

// Audio callback counter
static volatile uint32_t audio_callback_count = 0;

// Audio callback - OPTIMIZED for minimal latency
void AudioCallback(AudioHandle::InputBuffer in,
                   AudioHandle::OutputBuffer out,
                   size_t size)
{
    audio_callback_count++;

    // Always copy dry (zero latency)
    float dry_L[kBlockSize];
    float dry_R[kBlockSize];

    for (size_t i = 0; i < size; ++i) {
        dry_L[i] = in[0][i];
        dry_R[i] = in[1][i];
    }

    if (!reverb_ready_ || bypass_) {
        // Bypass - just output dry
        for (size_t i = 0; i < size; ++i) {
            out[0][i] = dry_L[i];
            out[1][i] = dry_R[i];
        }
        return;
    }

    // Process reverb
    float early_L[kBlockSize];
    float early_R[kBlockSize];
    float tail_L[kBlockSize];
    float tail_R[kBlockSize];

    // Early reflections (FIR - true IR)
    fir.ProcessBlock(in[0], in[1], early_L, early_R, size);

    // Tail reverb (algorithmic, fitted to IR)
    tail.ProcessBlock(in[0], in[1], tail_L, tail_R, size);

    // Mix
    float mix = smMix.value;
    for (size_t i = 0; i < size; ++i) {
        float wet_L = early_L[i] + tail_L[i];
        float wet_R = early_R[i] + tail_R[i];

        out[0][i] = dry_L[i] * (1.0f - mix) + wet_L * mix;
        out[1][i] = dry_R[i] * (1.0f - mix) + wet_R * mix;
    }
}

// Initialize reverb with selected IR
void InitReverb(int ir_index)
{
    hw.seed.PrintLine("  InitReverb: Starting");

    if (ir_index < 0 || ir_index >= 4) ir_index = 0;
    current_ir_index_ = ir_index;

    const char* ir_names[] = {"Studio", "Church", "Dome", "Hall"};
    char buf[80];
    snprintf(buf, sizeof(buf), "  Selected IR %d: PS1_%s (precomputed)", ir_index, ir_names[ir_index]);
    hw.seed.PrintLine(buf);

    // Load precomputed profile
    profiles[ir_index] = PrecomputedProfiles::kProfiles[ir_index];

    // Copy FIR taps from global storage (loaded from binary)
    const float* src_taps = &PrecomputedProfiles::g_AllTaps[ir_index * 330];
    std::memcpy(profiles[ir_index].taps, src_taps, 330 * sizeof(float));

    // Verify first tap
    snprintf(buf, sizeof(buf), "    Tap[0] = %d (µ)", (int)(profiles[ir_index].taps[0] * 1000000.0f));
    hw.seed.PrintLine(buf);

    snprintf(buf, sizeof(buf), "  Profile: %u FIR taps, %u combs, RT60 mid=%.2fs",
             (unsigned int)profiles[ir_index].N_taps,
             (unsigned int)profiles[ir_index].N_combs,
             profiles[ir_index].rt60_band[1]);
    hw.seed.PrintLine(buf);

    // Initialize FIR with precomputed taps
    hw.seed.PrintLine("  Initializing FIR convolver...");
    fir.Reset();
    fir.Init(profiles[ir_index].taps, profiles[ir_index].N_taps);

    // Initialize tail with precomputed parameters
    hw.seed.PrintLine("  Initializing tail reverb...");
    tail.Init(sample_rate_);
    tail.SetFromProfile(profiles[ir_index]);

    snprintf(buf, sizeof(buf), "    Tail: %u combs, %u allpass, predelay=%.1fms",
             (unsigned int)profiles[ir_index].N_combs,
             (unsigned int)profiles[ir_index].N_allpass,
             profiles[ir_index].predelay_ms);
    hw.seed.PrintLine(buf);

    hw.seed.PrintLine("  InitReverb: Complete");
}

int main()
{
    // Hardware initialization
    hw.Init();
    hw.SetAudioBlockSize(kBlockSize);
    hw.SetAudioSampleRate(SaiHandle::Config::SampleRate::SAI_48KHZ);

    sample_rate_ = hw.AudioSampleRate();

    // Initialize USB logging
    hw.seed.usb_handle.Init(UsbHandle::FS_INTERNAL);
    System::Delay(250);
    hw.seed.StartLog(false);

    // Blink LED1 while waiting for USB
    led1.Init(hw.seed.GetPin(Hothouse::LED_1), false);
    for (int i = 0; i < 50; ++i) {
        led1.Set((i % 2) ? 1.0f : 0.0f);
        led1.Update();
        System::Delay(100);
    }

    hw.seed.PrintLine("=== PSXVerb Hybrid IR Reverb ===");
    hw.seed.PrintLine("Architecture: FIR Early + Fitted Tail");

    // Initialize LEDs
    led1.Init(hw.seed.GetPin(Hothouse::LED_1), false);
    led2.Init(hw.seed.GetPin(Hothouse::LED_2), false);

    // Initialize parameter smoothers
    smMix.Init(0.5f);

    // Zero out IR profiles (will analyze on demand)
    for (int i = 0; i < 4; ++i) {
        std::memset(&profiles[i], 0, sizeof(IRProfile));
    }

    hw.seed.PrintLine("Starting audio...");

    // Start audio
    hw.StartAdc();
    hw.StartAudio(AudioCallback);

    hw.seed.PrintLine("Audio started");

    // Initialize first IR (IR 0) after a delay
    System::Delay(500);

    hw.seed.PrintLine("Loading IR taps (1500 taps × 4 IRs from SDRAM)...");

    // Load all IR taps from SDRAM const arrays (31.25ms @ 48kHz)
    using namespace IRTaps;
    std::memcpy(&PrecomputedProfiles::g_AllTaps[0], kStudio_Taps, 1500 * sizeof(float));
    std::memcpy(&PrecomputedProfiles::g_AllTaps[1500], kChurch_Taps, 1500 * sizeof(float));
    std::memcpy(&PrecomputedProfiles::g_AllTaps[3000], kDome_Taps, 1500 * sizeof(float));
    std::memcpy(&PrecomputedProfiles::g_AllTaps[4500], kHall_Taps, 1500 * sizeof(float));

    hw.seed.PrintLine("  Loaded 4 IRs × 1500 taps (31.25ms early reflections)");
    hw.seed.PrintLine("Initializing IR 0 (Studio)...");
    InitReverb(0);
    reverb_ready_ = true;
    bypass_ = true;  // Start in bypass

    hw.seed.PrintLine("Ready! Press footswitch to enable reverb");
    hw.seed.PrintLine("Knob 1: IR selection (0-3)");
    hw.seed.PrintLine("Knob 6: Wet/Dry mix");

    // Main loop
    uint32_t loop_count = 0;
    uint32_t last_audio_count = 0;
    uint32_t last_log_time = System::GetNow();
    int last_ir_selection = 0;

    while (true)
    {
        loop_count++;
        uint32_t now = System::GetNow();

        // Process controls
        hw.ProcessAllControls();

        // Handle footswitch (bypass toggle)
        if (hw.switches[Hothouse::FOOTSWITCH_1].RisingEdge())
        {
            bypass_ = !bypass_;
            if (bypass_) {
                smMix.Init(0.0f);  // Fade out
                tail.Reset();      // Clear tail on bypass
            }
        }

        // Handle knob changes (rate limited)
        static uint32_t last_knob_check = 0;
        if (now - last_knob_check >= 100)  // Check every 100ms
        {
            // Knob 1: IR Selection (0-3)
            int ir_selection = static_cast<int>(hw.GetKnobValue(Hothouse::KNOB_1) * 3.99f);
            if (ir_selection != last_ir_selection && ir_selection >= 0 && ir_selection < 4) {
                char buf[64];
                snprintf(buf, sizeof(buf), "Switching to IR %d...", ir_selection);
                hw.seed.PrintLine(buf);

                InitReverb(ir_selection);
                last_ir_selection = ir_selection;
            }

            // Knob 6: Wet/Dry Mix
            float mix_target = bypass_ ? 0.0f : hw.GetKnobValue(Hothouse::KNOB_6);
            smMix.Process(mix_target);

            last_knob_check = now;
        }

        // Log every second
        if (now - last_log_time >= 1000) {
            char buf[128];
            uint32_t current_audio_count = audio_callback_count;
            snprintf(buf, sizeof(buf),
                     "Loop: %lu | Audio: %lu (Δ%lu) | IR: %d | Bypass: %s | Mix: %.2f",
                     loop_count, current_audio_count, current_audio_count - last_audio_count,
                     current_ir_index_,
                     bypass_ ? "ON" : "OFF",
                     smMix.value);
            hw.seed.PrintLine(buf);
            last_audio_count = current_audio_count;
            last_log_time = now;
        }

        // LED 1: Bypass indicator (on = active, off = bypassed)
        led1.Set(bypass_ ? 0.0f : 1.0f);
        led1.Update();

        // LED 2: Mix level
        led2.Set(smMix.value);
        led2.Update();

        hw.CheckResetToBootloader();
    }

    return 0;
}
